{
  "expo": {
    "name": "staple",
    "slug": "staple",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#FFFFFF",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.staple.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "staple uses your location to discover ongoing Group Buys in your neighborhood."
      }
    },
    "android": {
      "package": "com.staple.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1F44"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "staple",
    "extra": {
      "eas": {
        "projectId": "06f74847-dabb-4751-804f-592c94dd2d72"
      }
    },
    "owner": "penweaver"
  }
}
