{
  "expo": {
    "name": "staple",
    "slug": "staple",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.staple.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "staple uses your location to discover ongoing Group Buys in your neighborhood."
      }
    },
    "android": {
      "package": "com.staple.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {},
    "scheme": "staple"
  }
}
