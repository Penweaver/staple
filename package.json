{
  "name": "staple-platform",
  "version": "1.0.0",
  "private": true,
  "description": "STAPLE LIMITED — Location-aware collective purchasing platform",
  "workspaces": [
    "shared",
    "mobile",
    "admin",
    "tests"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace=@staple/shared",
    "build:shared": "npm run build --workspace=@staple/shared",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test --workspace=@staple/tests",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "overrides": {
    "react-native": "0.74.1",
    "react": "18.2.0"
  },
  "keywords": [
    "staple",
    "group-buy",
    "collective-purchasing",
    "nigeria",
    "mobile-first"
  ],
  "author": "STAPLE LIMITED",
  "license": "UNLICENSED"
}
